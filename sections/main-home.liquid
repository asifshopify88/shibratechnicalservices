{% comment %}Compact homepage for Shibra Technical Services{% endcomment %}
<section class="hero" id="home">
  <div class="container hero-content">
    <div class="eyebrow">Construction &amp; Technical Services · Dubai, UAE</div>
    <h1>Reliable Work.<br>Quality That Lasts.</h1>
    <p>Professional construction and building maintenance solutions for homes, offices and commercial properties across Dubai.</p>
    <div class="hero-actions">
      <a class="btn" href="#services">EXPLORE OUR SERVICES</a>
      <a class="btn-outline" href="#contact">GET A FREE QUOTE</a>
    </div>
    <div class="hero-note">MASONRY · BLOCK WORK · PAINTING · BUILDING MAINTENANCE</div>
  </div>
</section>

<div class="trust-strip">
  <div class="container trust-inner">
    <span>Quality Workmanship</span>
    <span>Professional Service</span>
    <span>Residential &amp; Commercial</span>
    <span>Dubai, UAE</span>
  </div>
</div>

<section class="section services" id="services">
  <div class="container">
    <div class="section-head">
      <div class="section-kicker">What We Do</div>
      <h2>Our Core Services</h2>
      <p>From construction work to everyday property maintenance, one team for the essential jobs your building needs.</p>
    </div>
    <div class="service-grid">
      <article class="service-card"><span class="service-no">01 / MASONRY</span><h3>Masonry Work</h3><p>Professional masonry solutions for durable walls, structures and property improvements.</p></article>
      <article class="service-card"><span class="service-no">02 / BLOCK WORK</span><h3>Block Work</h3><p>Accurate block laying and wall construction for residential and commercial spaces.</p></article>
      <article class="service-card"><span class="service-no">03 / PAINTING</span><h3>Paint Work</h3><p>Interior and exterior painting with neat preparation and quality finishing.</p></article>
      <article class="service-card"><span class="service-no">04 / PLASTER</span><h3>Plaster Work</h3><p>Smooth plastering and surface preparation for a clean, even finish.</p></article>
      <article class="service-card"><span class="service-no">05 / PLUMBING</span><h3>Plumbing</h3><p>Practical plumbing installation, repairs and general fixture maintenance.</p></article>
      <article class="service-card"><span class="service-no">06 / ELECTRICAL</span><h3>Electrical Work</h3><p>Electrical installation, troubleshooting and maintenance for your property.</p></article>
      <article class="service-card"><span class="service-no">07 / MAINTENANCE</span><h3>General Maintenance</h3><p>Reliable property upkeep and repair support to keep your space working smoothly.</p></article>
    </div>
  </div>
</section>

<section class="section" id="about">
  <div class="container about-grid">
    <div class="about-image" role="img" aria-label="Modern building under construction">
      <div class="image-label"><strong>One Team</strong>For Essential Building Services</div>
    </div>
    <div class="about-copy">
      <div class="section-kicker">About Shibra</div>
      <h2>Practical Solutions. Professional Results.</h2>
      <p>Shibra Technical Services supports property owners, businesses and contractors with dependable construction and maintenance work in Dubai.</p>
      <ul>
        <li>Clear communication from enquiry to completion</li>
        <li>Careful workmanship and attention to detail</li>
        <li>Support for residential and commercial properties</li>
      </ul>
      <a class="btn" href="#contact">TALK TO OUR TEAM</a>
    </div>
  </div>
</section>

<section class="cta-band" id="contact">
  <div class="container cta-inner">
    <div><h2>Need a job done right?</h2><p>Tell us what you need and request a quotation from our team.</p></div>
    <a class="btn btn-dark" href="https://wa.me/971500000000" target="_blank" rel="noopener">CONTACT US ON WHATSAPP ↗</a>
  </div>
</section>

