<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#101b2b">
  <title>{% if page_title %}{{ page_title }} | {% endif %}Shibra Technical Services</title>
  <meta name="description" content="Shibra Technical Services provides construction, interior fit-out and building maintenance services across Dubai, UAE.">
  {{ content_for_header }}
  <style>
    :root{--navy:#101b2b;--navy2:#17283d;--gold:#d9a441;--cream:#f5f3ee;--ink:#182333;--muted:#687486;--white:#fff;--line:#e7e8eb}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:#fff}a{color:inherit;text-decoration:none}img{max-width:100%;display:block}button,input,textarea{font:inherit}.container{width:min(1160px,calc(100% - 40px));margin:auto}
    .site-header{position:sticky;top:0;z-index:50;background:rgba(16,27,43,.97);color:#fff;border-bottom:1px solid rgba(255,255,255,.1)}.header-inner{height:82px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{font-size:21px;font-weight:800;letter-spacing:.5px}.brand span{display:block;color:var(--gold);font-size:10px;letter-spacing:3px;margin-top:4px}.nav{display:flex;align-items:center;gap:28px;font-size:13px;font-weight:700}.nav a:hover{color:var(--gold)}.nav-cta,.btn{display:inline-flex;align-items:center;justify-content:center;background:var(--gold);color:#111b28;padding:14px 21px;font-weight:800;font-size:12px;letter-spacing:.6px;border:0;cursor:pointer;transition:.2s}.nav-cta:hover,.btn:hover{background:#edbd61;transform:translateY(-2px)}.menu-toggle{display:none;background:none;border:1px solid #647083;color:#fff;padding:9px 12px}
    .hero{position:relative;min-height:650px;display:flex;align-items:center;color:#fff;background:linear-gradient(90deg,rgba(9,18,30,.92),rgba(9,18,30,.68) 52%,rgba(9,18,30,.2)),url('https://images.unsplash.com/photo-1487958449943-2429e8be8625?auto=format&fit=crop&w=2000&q=85') center/cover}.hero-content{max-width:690px;padding:100px 0}.eyebrow{display:flex;align-items:center;gap:12px;color:var(--gold);font-size:11px;font-weight:800;letter-spacing:2.5px;text-transform:uppercase}.eyebrow:before{content:"";width:34px;height:2px;background:var(--gold)}h1{font-size:clamp(42px,6vw,72px);line-height:1.04;letter-spacing:-2px;margin:22px 0}.hero p{max-width:570px;color:#d6dbe2;font-size:17px;line-height:1.8;margin:0 0 30px}.hero-actions{display:flex;gap:14px;flex-wrap:wrap}.btn-outline{border:1px solid rgba(255,255,255,.6);color:#fff;padding:14px 21px;font-size:12px;font-weight:800}.btn-outline:hover{border-color:var(--gold);color:var(--gold)}.hero-note{margin-top:60px;border-left:2px solid var(--gold);padding-left:16px;color:#dce1e8;font-size:12px;letter-spacing:1px}
    .trust-strip{background:var(--gold);padding:19px 0}.trust-inner{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;color:#172235;font-size:12px;font-weight:800;letter-spacing:1px;text-transform:uppercase}.trust-inner span:before{content:"✓";margin-right:9px}
    section{scroll-margin-top:82px}.section{padding:100px 0}.section-head{max-width:680px;margin-bottom:46px}.section-kicker{color:#b78327;font-size:11px;font-weight:800;letter-spacing:2.5px;text-transform:uppercase}.section h2{font-size:clamp(32px,4vw,48px);line-height:1.12;letter-spacing:-1.2px;margin:14px 0 18px;color:var(--navy)}.section-head p,.about-copy p{color:var(--muted);line-height:1.8;font-size:15px}.services{background:var(--cream)}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.service-card{background:#fff;padding:30px 27px;min-height:230px;border:1px solid #ece9e1;transition:.25s}.service-card:hover{transform:translateY(-5px);box-shadow:0 16px 35px rgba(17,31,49,.09);border-color:var(--gold)}.service-no{color:#c08c31;font-size:12px;font-weight:800;letter-spacing:1px}.service-card h3{font-size:19px;color:var(--navy);margin:25px 0 11px}.service-card p{font-size:13px;color:var(--muted);line-height:1.7;margin:0}.service-arrow{display:inline-block;color:#b78327;margin-top:18px;font-weight:800}
    .about-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}.about-image{min-height:470px;background:linear-gradient(0deg,rgba(16,27,43,.12),rgba(16,27,43,.12)),url('https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&w=1100&q=85') center/cover;position:relative}.image-label{position:absolute;bottom:24px;left:24px;background:var(--gold);padding:20px 24px;color:var(--navy);font-weight:800}.image-label strong{font-size:30px;display:block}.about-copy ul{list-style:none;padding:0;margin:25px 0}.about-copy li{padding:10px 0;border-bottom:1px solid var(--line);font-size:14px}.about-copy li:before{content:"✓";color:#b78327;font-weight:900;margin-right:12px}
    .why{background:var(--navy);color:#fff}.why .section h2,.why h2{color:#fff}.why .section-head p{color:#bdc6d2}.why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:26px}.why-item{border-top:2px solid var(--gold);padding-top:22px}.why-item b{font-size:17px}.why-item p{font-size:13px;color:#bdc6d2;line-height:1.7}
    .projects-grid{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:16px}.project{height:290px;position:relative;overflow:hidden;background:#ddd}.project img{width:100%;height:100%;object-fit:cover;transition:.5s}.project:hover img{transform:scale(1.06)}.project:after{content:"";position:absolute;inset:35% 0 0;background:linear-gradient(transparent,rgba(8,17,29,.88))}.project-caption{position:absolute;z-index:1;bottom:22px;left:22px;color:#fff}.project-caption small{color:var(--gold);font-weight:800;letter-spacing:1px}.project-caption h3{margin:7px 0 0;font-size:19px}
    .cta-band{background:var(--gold);padding:58px 0}.cta-inner{display:flex;align-items:center;justify-content:space-between;gap:25px}.cta-inner h2{color:var(--navy);font-size:clamp(28px,4vw,40px);margin:0 0 8px}.cta-inner p{margin:0;color:#374153}.btn-dark{background:var(--navy);color:#fff;white-space:nowrap}.btn-dark:hover{background:#263b55}
    .contact{background:var(--cream)}.contact-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:65px}.contact-details{display:grid;gap:20px;margin-top:30px}.contact-detail b{display:block;color:var(--navy);font-size:13px;margin-bottom:6px}.contact-detail span{color:var(--muted);font-size:14px}.contact-form{background:#fff;padding:34px;box-shadow:0 12px 35px rgba(17,31,49,.06)}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}.field{margin-bottom:16px}.field label{display:block;font-size:11px;font-weight:800;letter-spacing:.7px;margin-bottom:8px;color:#39465a}.field input,.field textarea,.field select{width:100%;padding:13px 14px;border:1px solid #dfe2e7;background:#fff;outline:none}.field input:focus,.field textarea:focus,.field select:focus{border-color:#c18d35}.field textarea{min-height:120px;resize:vertical}.contact-form .btn{width:100%}
    footer{background:#0b1421;color:#fff;padding:55px 0 25px}.footer-top{display:flex;justify-content:space-between;gap:40px;padding-bottom:40px}.footer-copy{max-width:390px;color:#aeb8c5;font-size:13px;line-height:1.8}.footer-links{display:flex;gap:24px;flex-wrap:wrap;font-size:12px;color:#d6dbe2}.footer-bottom{border-top:1px solid #263346;padding-top:22px;color:#8e9bab;font-size:11px;display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}.whatsapp{position:fixed;right:22px;bottom:22px;z-index:60;background:#1fae62;color:#fff;padding:15px 18px;border-radius:40px;font-size:12px;font-weight:800;box-shadow:0 7px 24px #0003}
    @media(max-width:850px){.nav{display:none;position:absolute;top:82px;left:0;right:0;background:var(--navy);padding:24px;flex-direction:column;align-items:flex-start}.nav.open{display:flex}.menu-toggle{display:block}.nav-cta{display:none}.service-grid{grid-template-columns:repeat(2,1fr)}.about-grid,.contact-grid{grid-template-columns:1fr;gap:38px}.why-grid{grid-template-columns:repeat(2,1fr)}.projects-grid{grid-template-columns:1fr 1fr}.project:first-child{grid-column:span 2}.cta-inner{align-items:flex-start;flex-direction:column}}
    @media(max-width:560px){.container{width:min(100% - 30px,1160px)}.header-inner{height:72px}.nav{top:72px}.hero{min-height:600px}.hero-content{padding:75px 0}.hero p{font-size:15px}.section{padding:72px 0}.service-grid,.why-grid,.projects-grid,.form-row{grid-template-columns:1fr}.project:first-child{grid-column:auto}.project{height:250px}.about-image{min-height:340px}.contact-form{padding:23px}.footer-top{flex-direction:column}.trust-inner{gap:13px}.whatsapp{right:14px;bottom:14px}}
  </style>
</head>
<body>
  <header class="site-header"><div class="container header-inner">
    <a class="brand" href="#home">SHIBRA <span>TECHNICAL SERVICES</span></a>
    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false">MENU</button>
    <nav class="nav" aria-label="Main navigation"><a href="#home">HOME</a><a href="#services">SERVICES</a><a href="#about">ABOUT</a><a href="#contact">CONTACT</a></nav>
    <a class="nav-cta" href="#contact">REQUEST A QUOTE</a>
  </div></header>
  {{ content_for_layout }}
  <a class="whatsapp" href="https://wa.me/971500000000" target="_blank" rel="noopener">WHATSAPP US ↗</a>
  <script>
    (()=>{const toggle=document.querySelector('.menu-toggle'),nav=document.querySelector('.nav');if(toggle&&nav){toggle.addEventListener('click',()=>{const open=nav.classList.toggle('open');toggle.setAttribute('aria-expanded',String(open));});nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('open');toggle.setAttribute('aria-expanded','false');}));}
    const form=document.querySelector('#quote-form');if(form){form.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(form);const msg=['Hello Shibra Technical Services, I would like to request a quotation.','Name: '+d.get('name'),'Email: '+d.get('email'),'Phone: '+d.get('phone'),'Service: '+d.get('service'),'Message: '+d.get('message')].join('\n');window.open('https://wa.me/971500000000?text='+encodeURIComponent(msg),'_blank','noopener');});}
    })();
  </script>
</body>
</html>